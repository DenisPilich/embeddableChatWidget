{
  "name": "ecw-widget",
  "version": "0.1.2",
  "description": "Embeddable chat widget: a 678-byte loader, Shadow DOM isolation, lazy loading",
  "license": "MIT",
  "keywords": [
    "chat",
    "chat-widget",
    "widget",
    "embeddable",
    "shadow-dom",
    "customer-support"
  ],
  "type": "module",
  "sideEffects": true,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/ecw-widget.js",
  "module": "./dist/ecw-widget.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/ecw-widget.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.loader.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@ecw/shared": "workspace:*",
    "typescript": "6.0.3",
    "vite": "^8.3.2"
  }
}
