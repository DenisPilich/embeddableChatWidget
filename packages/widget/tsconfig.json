{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Виджет живёт в браузере, поэтому здесь появляется DOM.
    // В базовом конфиге его нет намеренно: общий пакет не должен уметь
    // обращаться к document.
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "vite.config.ts", "vite.loader.config.ts"]
}
