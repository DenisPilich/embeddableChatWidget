# Файл, который Next.js перезаписывает сам при каждой сборке и запуске. Наш
# формат он всё равно не сохранит: проверка на нём будет падать всегда, а не
# тогда, когда в проекте действительно неровный код.
apps/web/next-env.d.ts

# Файл блокировки генерирует pnpm. Форматировать его нельзя: любая правка
