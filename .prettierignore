pnpm-lock.yaml

# Markdown — это текст, который читает человек, а не код.
# Prettier переписывает таблицы в широкие выровненные колонки: смысла не
# прибавляется, а исходник становится неудобно читать в узком окне редактора
# и в diff. Документы в этом проекте пишутся руками.
*.md
