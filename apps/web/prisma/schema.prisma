// Схема данных. Postgres в Neon.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Строк подключения здесь больше нет: в Prisma 7 они переехали.
  //   * для миграций — в prisma.config.ts, там прямое соединение;
  //   * для работы приложения — в адаптер драйвера, см. lib/prisma.ts.
  // Это не косметика: приложению нужен пулер соединений, а миграциям — прямое
  // подключение, и держать их в одном месте было нельзя.
}

// ── Люди по нашу сторону ────────────────────────────────────────────────────

/// Сотрудник: владелец сайта или оператор поддержки.
model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String?
  createdAt    DateTime     @default(now())
  memberships  Membership[]

  /// Хеш кода восстановления. Сам код не хранится: он показывается один раз
  /// тому, кому принадлежит учётная запись, и потеря базы не должна давать
  /// возможности сбросить чужой пароль.
  recoveryHash String?

  /// Номер поколения сессий. Увеличивается при смене и при восстановлении
  /// пароля, после чего все выданные ранее cookie перестают подходить.
  ///
  /// Без этого смена пароля не выгоняла бы того, кто уже вошёл: cookie подписана
  /// и живёт своей жизнью двенадцать часов. Для восстановления это особенно
  /// важно — иначе тот, кто получил доступ, остался бы в панели и после смены
  /// пароля.
  sessionVersion Int @default(0)

  @@map("users")
}

/// Рабочее пространство — команда. Лежит НАД сайтами: один человек может
/// обслуживать несколько сайтов, и без этого уровня пришлось бы заводить
/// отдельный аккаунт на каждый.
model Workspace {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  memberships Membership[]
  sites       Site[]

  @@map("workspaces")
}

enum MembershipRole {
  OWNER
  ADMIN
  AGENT
}

/// Связь человека с рабочим пространством и его роль в нём.
model Membership {
  id          String         @id @default(cuid())
  userId      String
  workspaceId String
  role        MembershipRole @default(AGENT)
  createdAt   DateTime       @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("memberships")
}

// ── Сайты клиентов ──────────────────────────────────────────────────────────

model Site {
  id        String   @id @default(cuid())
  workspaceId String
  name      String
  createdAt DateTime @default(now())

  /// Публичный ключ виджета. Секретом НЕ является: он виден в HTML любого
  /// клиента. Защита строится не на его секретности, а на проверке Origin.
  publicKey String @unique

  /// Список доменов, с которых разрешено обращаться к API этого сайта.
  /// Без него чужой человек, скопировав publicKey со страницы, сможет слать
  /// сообщения в базу и жечь бюджет ассистента.
  allowedOrigins String[]

  /// Внешний вид виджета на этом сайте. Пусто — значит вид по умолчанию.
  ///
  /// Хранится у сайта, а не в коде виджета: у каждого клиента свой вид, а
  /// пересобирать бандл из-за цвета нельзя — он у всех один и тот же.
  widgetColor    String?
  widgetTitle    String?
  widgetGreeting String?

  /// Отвечает ли ассистент на свободные вопросы.
  ///
  /// По умолчанию выключен: сначала посетителю показывают меню, а свободный
  /// вопрос — это последний пункт, а не единственный вход. Владелец, которому
  /// ассистент не нужен вовсе, просто не включает галочку.
  aiEnabled Boolean @default(false)

  /// Сколько секунд ждать оператора, прежде чем предложить оставить телефон.
  /// Пределы 60–1800 (одна–тридцать минут) проверяются в панели.
  handoverTimeoutSeconds Int @default(300)

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  visitors      Visitor[]
  conversations Conversation[]
  aiConfig      AiConfig?
  tokenUsage    TokenUsage[]
  menuOptions   MenuOption[]

  @@index([workspaceId])
  @@map("sites")
}

/// Настройки ассистента для конкретного сайта.
model AiConfig {
  id              String  @id @default(cuid())
  siteId          String  @unique
  systemPrompt    String
  model           String
  temperature     Float   @default(0.3)
  /// Суточный предел расхода токенов. Без него публичное демо выжигает
  /// бесплатную квоту за час.
  dailyTokenBudget Int    @default(100000)

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("ai_configs")
}

/// Учёт израсходованных токенов по дням.
model TokenUsage {
  id     String   @id @default(cuid())
  siteId String
  day    DateTime @db.Date
  tokens Int      @default(0)

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, day])
  @@map("token_usage")
}

// ── Посетители и переписка ──────────────────────────────────────────────────

/// Посетитель сайта клиента.
///
/// Отдельная сущность, а не «сессия»: человек возвращается, и без него нельзя
/// ни показать историю вернувшемуся, ни отличить сто посетителей по одному
/// сообщению от одного спамера на сто сообщений.
model Visitor {
  id         String   @id @default(cuid())
  siteId     String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  site          Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([siteId])
  @@map("visitors")
}

enum ConversationStatus {
  OPEN
  CLOSED
}

/// Диалог. Всё, что к нему относится, привязано к siteId — это граница
/// разграничения доступа между клиентами.
model Conversation {
  id        String             @id @default(cuid())
  siteId    String
  visitorId String
  status    ConversationStatus @default(OPEN)

  /// Монотонный номер последнего сообщения.
  /// По нему клиент просит «всё, что после N» — так периодический опрос не даёт
  /// ни дублей, ни пропусков.
  lastSeq Int @default(0)

  /// Когда посетитель позвал человека. Пусто — ассистент отвечает сам.
  ///
  /// Отдельное поле, а не статус диалога: диалог при этом остаётся открытым, в
  /// нём продолжают писать, и закрывать его должен оператор, а не факт просьбы.
  humanRequestedAt DateTime?

  /// Сколько раз подряд модель не смогла ответить.
  ///
  /// Сбрасывается любым успешным ответом. Нужен, чтобы отличить разовую
  /// неудачу сервиса от постоянной: после нескольких подряд посетителю
  /// предлагается человек, а не бесконечное «попробуйте позже».
  answerFailures Int @default(0)

  /// Телефон, оставленный посетителем, когда оператор не пришёл.
  ///
  /// Не отдельная сущность: номер нужен ровно в контексте этого разговора —
  /// «перезвонить вот этому человеку про вот это». Отдельная таблица заявок
  /// потребовала бы ещё одного экрана, который никто не открывает.
  phone String?

  /// Когда живой оператор впервые ответил в этом разговоре.
  ///
  /// С этого момента разговор ведёт человек, и ассистент молчит — даже когда
  /// ожидание уже закончилось и humanRequestedAt снят. Иначе модель отвечала бы
  /// поверх оператора, и посетитель читал бы двух собеседников по очереди.
  /// Снимается при закрытии: закрытый разговор окончен.
  humanJoinedAt DateTime?

  /// Отвечает ли ассистент в этом разговоре.
  ///
  /// Включается ТОЛЬКО тогда, когда посетитель выбрал пункт «свой вопрос».
  /// Раньше ассистент отвечал на любое сообщение, если он включён у сайта, — и
  /// отвечал даже при живом операторе. Теперь это свойство разговора, а не
  /// сайта: включённый у сайта ассистент лишь позволяет показать пункт меню.
  /// Снимается при закрытии — следующий разговор снова начинается с меню.
  aiMode Boolean @default(false)

  /// Когда по этому номеру перезвонили. Пусто — ещё не перезвонили.
  ///
  /// Без этой отметки номера уходят в пустоту, а обещание «мы вам перезвоним»
  /// становится ложью. Отметка ставится в панели одним нажатием.
  calledBackAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site     Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  visitor  Visitor   @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([siteId, status])
  @@index([visitorId])
  @@map("conversations")
}

// ── Меню для посетителя ─────────────────────────────────────────────────────

/// Что делает пункт меню.
enum MenuAction {
  /// Показать текстовый ответ.
  ANSWER
  /// Позвать живого оператора.
  OPERATOR
  /// Открыть подменю.
  SUBMENU
  /// Дать написать свой вопрос ассистенту.
  AI
}

/// Пункт меню, который видит посетитель в чате.
///
/// Дерево через parentId: подменю — это те же пункты внутри другого. Плоский
/// список из пяти вопросов читается, из двадцати — нет, а «конструктор
/// сценариев» с шагами и условиями не заполняет никто.
model MenuOption {
  id       String  @id @default(cuid())
  siteId   String
  parentId String?

  /// Текст на кнопке. Виден посетителю и попадает в переписку как вопрос —
  /// оператор должен видеть, что именно человек выбрал.
  label String

  action MenuAction @default(ANSWER)

  /// Текст ответа. Обязателен для ANSWER, пуст у остальных.
  answer String?

  /// Порядок среди соседей, от меньшего к большему.
  position Int @default(0)

  /// Сколько раз нажали. Единственная статистика, которая здесь окупается:
  /// владелец видит, какие вопросы задают на самом деле, и переделывает меню
  /// по факту, а не по догадке.
  clicks Int @default(0)

  createdAt DateTime @default(now())

  site     Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parent   MenuOption? @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuOption[] @relation("MenuTree")

  @@index([siteId, parentId, position])
  @@map("menu_options")
}

enum MessageAuthor {
  VISITOR
  AI
  AGENT
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  /// Порядковый номер внутри диалога. Уникален вместе с conversationId —
  /// это защищает от случайной двойной вставки.
  seq            Int
  author         MessageAuthor
  /// Кто именно ответил, если это человек. Для посетителя и ассистента пусто.
  authorUserId   String?
  /// Идентификатор, который присвоил клиент. На нём держится идемпотентность:
  /// если ответ не дошёл и виджет повторит отправку, второго сообщения не будет.
  /// Пусто у сообщений ассистента и оператора — им повторная отправка не грозит.
  clientId       String?
  body           String
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, seq])
  /// Postgres считает пустые значения различными, поэтому сообщения без clientId
  /// под это ограничение не попадают и друг с другом не конфликтуют.
  @@unique([conversationId, clientId])
  @@index([conversationId, createdAt])
  @@map("messages")
}
