# Строки подключения к базе. Скопируй этот файл в .env и подставь свои значения.
#
# Почему .env, а не .env.local: Next.js читает оба, а Prisma CLI (через
# prisma.config.ts) — только .env. Держать секреты в двух файлах значит однажды
# их рассогласовать.
#
# Оба файла уже в .gitignore: в репозиторий секреты не попадут.

# ── С ПУЛЕРОМ ───────────────────────────────────────────────────────────────
# В адресе хоста есть «-pooler». Эту строку использует приложение: в serverless
# каждое обращение — отдельный процесс, и без пулера соединения к базе
# заканчиваются очень быстро.
DATABASE_URL="postgresql://НЕ_ЗАБУДЬ_ВСТАВИТЬ@example-pooler.neon.tech/neondb?sslmode=require"

# ── БЕЗ ПУЛЕРА ──────────────────────────────────────────────────────────────
# В адресе хоста нет «-pooler». Эту строку используют миграции: через пулер
# Prisma мигрировать не умеет.
DIRECT_URL="postgresql://НЕ_ЗАБУДЬ_ВСТАВИТЬ@example.neon.tech/neondb?sslmode=require"

# ── Секрет для подписи токенов виджета ──────────────────────────────────────
# Случайная строка не короче 32 символов. Сгенерировать можно так:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#
# Заглушка ниже намеренно короткая: с ней приложение откажется работать и скажет
# об этом прямо. Молча работать с общеизвестным секретом хуже, чем не работать.
# Для прода нужен свой секрет, отдельный от локального.
ECW_TOKEN_SECRET="ЗАМЕНИ_МЕНЯ"

# ── Модель, которая отвечает посетителям ────────────────────────────────────
# Без ключа проект работает целиком: ассистент отвечает заготовками. Это
# осознанно — установить, запустить и посмотреть демо можно, не заводя ни одного
# аккаунта. Настроенный сервис виден на /api/health/ai, а работоспособность ключа
# проверяет /api/health/ai?check=1 — один настоящий запрос к модели.
#
# Сервис выбирается здесь:
#   groq    — ключ: https://console.groq.com/keys
#   gemini  — ключ: https://aistudio.google.com/apikey
#   custom  — свой адрес в ECW_AI_ENDPOINT, в том числе модель на своём компьютере
#   canned  — заготовки, без обращения к сети
#
# Все они говорят на одном языке (chat completions), поэтому смена сервиса —
# это правка настроек, а не кода.
ECW_AI_PROVIDER="groq"

# Ключ выбранного сервиса. Для модели на своём компьютере подойдёт любая
# непустая строка: локальные серверы ключ обычно не проверяют.
# Старое имя GROQ_API_KEY тоже принимается.
ECW_AI_KEY=""

# Адрес точки chat completions. Нужен только для сервиса `custom`.
# Пример для Ollama: http://localhost:11434/v1/chat/completions
ECW_AI_ENDPOINT=""

# Имя модели. Пусто — берётся значение выбранного сервиса по умолчанию.
# Действующие имена: https://console.groq.com/docs/models
#                    https://ai.google.dev/gemini-api/docs/models
# Провайдеры меняют список чаще, чем мы выпускаем версии, поэтому при ошибке
# «модель не найдена» смотри список, а не этот файл.
ECW_AI_MODEL=""
